DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docchat
PORT=3000

# "openai" (default) works with OpenAI or any OpenAI-compatible API. "mock" runs fully offline.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=900
CHUNK_OVERLAP=150
MIN_SIMILARITY=0.2
